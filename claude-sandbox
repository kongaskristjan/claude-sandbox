#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BASE_COMPOSE="$SCRIPT_DIR/docker-compose.yml"
export HOST_UID="$(id -u)"

usage() {
    echo "Usage: claude-sandbox [--gpu|--rust] [--host-network] [--update] [--agents|--opencode] [--port <port>] [project-dir]"
    echo ""
    echo "Options:"
    echo "  --gpu           Use the CUDA image with NVIDIA GPU passthrough"
    echo "                  (default: CPU-only ubuntu:24.04 image)"
    echo "  --rust          Use the Rust image (rustup toolchain, no Python or"
    echo "                  CUDA) with persistent cargo registry and build caches"
    echo "  --host-network  Use host networking (always enabled for rootless Docker,"
    echo "                  opt-in for rootful Docker)"
    echo "  --update        Refresh the Claude Code binary in the image (other layers"
    echo "                  stay cached); future runs reuse the refreshed layer"
    echo "  --agents        Launch the background-agents view ('claude agents')"
    echo "                  instead of an interactive session"
    echo "  --opencode      Run opencode instead of Claude Code (same image; the"
    echo "                  agent is selected at runtime, not baked into one)"
    echo "  --port <port>   (--opencode only) Point opencode at an OpenAI-compatible"
    echo "                  server running on the host at this port; auto-enables"
    echo "                  host networking and auto-discovers its models"
    echo ""
    echo "Environment variables:"
    echo "  CLAUDE_SANDBOX_MODE=rootless|rootful  Override Docker mode auto-detection"
    echo "  ANTHROPIC_API_KEY=sk-ant-...          Use API key instead of subscription"
    echo "  OPENCODE_API_HOST=127.0.0.1          Host address --port targets (opencode)"
    exit 0
}

GPU=false
RUST=false
HOST_NETWORK=false
UPDATE=false
AGENTS=false
OPENCODE=false
PORT=""
PROJECT_DIR=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --gpu) GPU=true ;;
        --rust) RUST=true ;;
        --host-network) HOST_NETWORK=true ;;
        --update) UPDATE=true ;;
        --agents) AGENTS=true ;;
        --opencode) OPENCODE=true ;;
        --port)
            if [ "$#" -lt 2 ]; then
                echo "Error: --port requires a port number." >&2
                exit 1
            fi
            PORT="$2"
            shift
            ;;
        --help|-h) usage ;;
        *) PROJECT_DIR="$1" ;;
    esac
    shift
done

if [ "$GPU" = true ] && [ "$RUST" = true ]; then
    echo "Error: --gpu and --rust select different images; pick one." >&2
    exit 1
fi

if [ "$OPENCODE" = true ] && [ "$AGENTS" = true ]; then
    echo "Error: --opencode and --agents select different agents; pick one." >&2
    exit 1
fi

if [ -n "$PORT" ]; then
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
        echo "Error: --port must be a number between 1 and 65535 (got: $PORT)." >&2
        exit 1
    fi
    if [ "$OPENCODE" != true ]; then
        echo "Error: --port only applies to --opencode." >&2
        exit 1
    fi
fi

export PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"

# Which agent the entrypoint launches. Orthogonal to the image: opencode is
# installed in every image and picked at runtime, so it composes with
# --rust/--gpu/--host-network.
if [ "$OPENCODE" = true ]; then
    export SANDBOX_AGENT="opencode"
else
    export SANDBOX_AGENT="claude"
fi

# Port of a host OpenAI-compatible server (--port); empty unless --port is
# given. The entrypoint uses it (opencode only) to point opencode at
# http://127.0.0.1:<port>/v1 over host networking, where 127.0.0.1 is the host.
export OPENCODE_API_PORT="${PORT:-}"
export OPENCODE_API_HOST="${OPENCODE_API_HOST:-127.0.0.1}"

# Host-side auth source for each agent, mounted read-only into the container.
# Both are always defined so the placeholder step below can touch them.
export CLAUDE_CREDENTIALS_FILE="$HOME/.claude/.credentials.json"
export OPENCODE_AUTH_FILE="$HOME/.local/share/opencode/auth.json"
export OPENCODE_CONFIG_FILE="$HOME/.config/opencode/opencode.json"

if [ "$OPENCODE" = true ]; then
    # opencode auths from the forwarded auth.json (above) or ANTHROPIC_API_KEY
    # (already passed through compose). There is no Keychain/credentials-file
    # step. Missing auth is not fatal: opencode can also log in interactively.
    if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ ! -s "$OPENCODE_AUTH_FILE" ]; then
        echo "Warning: no opencode auth found."
        echo "Either export ANTHROPIC_API_KEY=sk-ant-... or run 'opencode' on the host first to log in."
    fi
else
    # Claude Code on macOS keeps subscription credentials in the login Keychain,
    # not in ~/.claude/.credentials.json (a Linux-only path), so there is no file
    # to forward and no amount of logging in on the host creates one. Export the
    # Keychain item to a private file for the life of this run and mount that.
    if [ "$(uname -s)" = "Darwin" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
        KEYCHAIN_CREDS="$(mktemp "${TMPDIR:-/tmp}/claude-sandbox-credentials.XXXXXX")"
        chmod 600 "$KEYCHAIN_CREDS"
        trap 'rm -f "$KEYCHAIN_CREDS"' EXIT
        if security find-generic-password -s "Claude Code-credentials" -w \
            > "$KEYCHAIN_CREDS" 2>/dev/null && [ -s "$KEYCHAIN_CREDS" ]; then
            export CLAUDE_CREDENTIALS_FILE="$KEYCHAIN_CREDS"
        fi
    fi

    if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ ! -s "$CLAUDE_CREDENTIALS_FILE" ]; then
        # API billing stores the key in config.json as primaryApiKey
        API_KEY_FROM_CONFIG=$(python3 -c "import json; print(json.load(open('$HOME/.claude/config.json')).get('primaryApiKey',''))" 2>/dev/null || true)
        if [ -n "$API_KEY_FROM_CONFIG" ]; then
            export ANTHROPIC_API_KEY="$API_KEY_FROM_CONFIG"
        else
            echo "Error: No authentication found."
            echo "Either export ANTHROPIC_API_KEY=sk-ant-... or run 'claude' on the host first to log in."
            exit 1
        fi
    fi
fi

# Create placeholder files so Docker bind-mounts don't fail
# when optional files don't exist. Both agents' mounted host files are covered
# (touching the unused set is harmless) so either agent works out of the box.
for f in "$CLAUDE_CREDENTIALS_FILE" "$HOME/.claude.json" "$HOME/.gitconfig" "$HOME/.config/pulse/cookie" \
         "$OPENCODE_AUTH_FILE" "$OPENCODE_CONFIG_FILE"; do
    if [ ! -f "$f" ]; then
        mkdir -p "$(dirname "$f")"
        touch "$f"
    fi
done

# Same for the host skills directory, which is bind-mounted into the container's
# config volume. Create it ourselves rather than letting Docker do it — under
# rootful Docker the daemon would create it owned by root.
mkdir -p "$HOME/.claude/skills"

# Detect rootless vs rootful Docker
detect_docker_mode() {
    if [ -n "${CLAUDE_SANDBOX_MODE:-}" ]; then
        case "$CLAUDE_SANDBOX_MODE" in
            rootless|rootful) echo "$CLAUDE_SANDBOX_MODE"; return ;;
            *) echo "Error: CLAUDE_SANDBOX_MODE must be 'rootless' or 'rootful'" >&2; exit 1 ;;
        esac
    fi

    if [ -S "/run/user/$HOST_UID/docker.sock" ]; then
        echo "rootless"
        return
    fi

    local docker_root
    docker_root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)"
    if [[ "$docker_root" == "$HOME"* ]]; then
        echo "rootless"
        return
    fi

    echo "rootful"
}

MODE="$(detect_docker_mode)"
OVERRIDE_COMPOSE="$SCRIPT_DIR/docker-compose.${MODE}.yml"

# --port reaches a service on the host, which the container can only do over
# host networking (127.0.0.1). Rootless already has host networking; opt
# rootful runs in too so the flag behaves the same in both modes.
if [ -n "$PORT" ] && [ "$MODE" = "rootful" ]; then
    HOST_NETWORK=true
fi

# Build compose file list
COMPOSE_FILES=(-f "$BASE_COMPOSE" -f "$OVERRIDE_COMPOSE")

if [ "$GPU" = true ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.gpu.yml")
fi

if [ "$RUST" = true ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.rust.yml")
fi

# Add host networking override if requested (meaningful for rootful; rootless already has it)
STATUS="$MODE"
[ "$GPU" = true ] && STATUS="$STATUS, gpu"
[ "$RUST" = true ] && STATUS="$STATUS, rust"
if [ "$HOST_NETWORK" = true ] && [ "$MODE" = "rootful" ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.host-network.yml")
    STATUS="$STATUS, host networking"
fi
echo "Docker mode: $STATUS"

# --update bumps a stamp that feeds the CLAUDE_CACHE_BUST build arg, which sits
# right before the Claude install layer in the Dockerfile. Docker keys layer
# cache on the arg's value, so a one-off value would only help the update run
# itself: the next plain build would pass the default again and match the old,
# stale layer. Persist the stamp and pass it on every build so all later runs
# resolve to the refreshed layer.
STAMP_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-sandbox/claude-update-stamp"
if [ "$UPDATE" = true ]; then
    mkdir -p "$(dirname "$STAMP_FILE")"
    date +%s > "$STAMP_FILE"
fi
CLAUDE_CACHE_BUST="$(cat "$STAMP_FILE" 2>/dev/null || echo 0)"
BUILD_ARGS=(--build-arg "CLAUDE_CACHE_BUST=$CLAUDE_CACHE_BUST")
if [ "$UPDATE" = false ]; then
    BUILD_ARGS+=(--quiet)
fi

# Override the default command to launch a specific agent/view. opencode runs
# in the compose working_dir (/workspace/project), so it takes no project arg.
RUN_ARGS=()
if [ "$OPENCODE" = true ]; then
    RUN_ARGS=(opencode --auto)
elif [ "$AGENTS" = true ]; then
    RUN_ARGS=(claude agents --dangerously-skip-permissions)
fi

docker compose "${COMPOSE_FILES[@]}" build "${BUILD_ARGS[@]}"
docker compose "${COMPOSE_FILES[@]}" run --rm claude-dev ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}
